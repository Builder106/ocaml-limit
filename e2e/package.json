{
  "name": "ocaml-lob-e2e",
  "private": true,
  "description": "Playwright + Gherkin demo-recording suite for the OCaml LOB dashboard. Produces mp4/gif demos that the README embeds.",
  "type": "module",
  "scripts": {
    "demo": "DEMO=1 playwright test --config playwright.demo.config.ts",
    "demo:headed": "DEMO=1 playwright test --config playwright.demo.config.ts --headed",
    "gifs": "bash scripts/to-gifs.sh",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "playwright-bdd": "^7.5.0",
    "typescript": "^5.6.0"
  }
}
